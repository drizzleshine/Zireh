# Settings for the Rust host (host/): relay, search and payments. The host reads this file
# itself (real environment variables win). The web app reads only VITE_HOST_URL, from app/.env
# (default http://127.0.0.1:8788).

# The AI behind the relay: any OpenAI-compatible /chat/completions endpoint.
# Without LLM_API_KEY the relay runs in labeled local-dev mode against Ollama.
LLM_API_KEY=
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1     # default with a key
# Models offered, as id:usdIn:usdOut per 1M tokens (an id alone: $0.30 / $0.90).
# Default with a key: the Nemotron 3 Super and Nemotron Ultra models on Token Factory.
# LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:0.3:0.9
# Extra request fields for every call, as JSON (local-dev default: {"reasoning_effort":"none"}).
# LLM_EXTRA_BODY={"reasoning_effort":"minimal"}
#
# Example, Meta's Model API:
#   LLM_BASE_URL=https://api.meta.ai/v1
#   LLM_MODELS=muse-spark-1.3
#   LLM_EXTRA_BODY={"reasoning_effort":"minimal"}
# Optional: Tavily web search through the relay (TAVILY_URL overrides the endpoint).
TAVILY_API_KEY=
# Local-dev mode (no LLM_API_KEY): LLM_BASE_URL defaults to http://127.0.0.1:11434/v1 (Ollama)
# and the first LLM_MODELS id (default nemotron-3-nano:4b) is the model that answers.

# Paid providers with simulated payments require an explicit capped demo.
# RELAY_DEMO=1
# RELAY_DEMO_QUOTE_LIMIT=5000000
# RELAY_DEMO_DAILY_LIMIT=20000000

# Real Zcash top-ups, watched in the host with a viewing key only (it can see payments, never spend).
# Unset: payments are simulated. Testnet coins are free, so paid providers still need RELAY_DEMO=1.
# ZCASH_UFVK=uviewtest1...
# ZCASH_NETWORK=testnet
# LIGHTWALLETD_URL=https://testnet.zec.rocks:443
# ZCASH_BIRTHDAY=
