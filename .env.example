# Nebius Token Factory key. Without it the relay runs in labeled local-dev mode.
NEBIUS_API_KEY=
# Optional: models the relay offers, as id:usdIn:usdOut per 1M tokens.
# RELAY_MODELS=nvidia/nemotron-3-super-120b-a12b:0.3:0.9
# Optional: Tavily web search through the relay.
TAVILY_API_KEY=
# Local model served by Ollama.
LOCAL_MODEL=nemotron-3-nano:4b

# Paid providers with simulated payments require an explicit capped demo.
# RELAY_DEMO=1
# RELAY_DEMO_QUOTE_LIMIT=5000000
# RELAY_DEMO_DAILY_LIMIT=20000000
