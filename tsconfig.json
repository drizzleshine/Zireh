{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src",
    "packages/*/test",
    "app/src",
    "app/test",
    "app/vite.config.ts",
    "legacy/*/src",
    "legacy/*/test",
    "scripts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./app/src/*"
      ]
    }
  }
}